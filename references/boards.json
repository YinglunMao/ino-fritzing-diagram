{
  "version": 1,
  "about": "开发板目录。新增板卡只需在此文件加一条，无需改动任何代码。",
  "schema": {
    "id": "唯一 id，也是 build_parts/build_wiring 里 part 字段的取值",
    "name": "显示名",
    "fqbn": "arduino-cli 的 FQBN（用于自动匹配）",
    "variants": "核心包 variants/ 目录名（用于经 pins_arduino.h 反查匹配）",
    "match": "额外的模糊匹配关键词（小写）",
    "hand_tuned": "若填写，则改用 parts_library.py 里同名的手工精修渲染器（按实拍照片校准过）",
    "size_mm": "[宽, 高]，单位毫米",
    "pcb": "板体配色 {fill, edge, corner_r}",
    "silk": "丝印颜色",
    "holes": "安装孔 [[x, y, r], ...]（相对板子左上角，毫米）",
    "connectors": "排针：side=top/bottom/left/right；top/bottom 用 at+y，left/right 用 at+x",
    "gpio": "丝印名 -> GPIO 号（用于生成「丝印 · GPIOx」双标注）",
    "decor": "装饰件（芯片/USB/按键/指示灯/文字），只为外观，不产生引脚",
    "source": "引脚数据来源，可溯源"
  },
